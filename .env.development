# NEW FILE (fix-redirect-uri): settings for `npm start` / `npm run dev`.
# This file is committed on purpose. Keep secrets in `.env`, which is not.
#
# Serve and open the dev site on 127.0.0.1 instead of localhost, so the
# address in the browser matches the Spotify redirect URI
# (http://127.0.0.1:3000/auth/callback).
HOST=127.0.0.1
